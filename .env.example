# ============================================================
# SKINORA — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME=SKINORA API
APP_VERSION=1.0.0
DEBUG=false

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
# Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# SQLite (development default):
DATABASE_URL=sqlite+aiosqlite:///./skinora.db

# PostgreSQL (production — swap in when ready):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skinora

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# File Upload
# ----------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
